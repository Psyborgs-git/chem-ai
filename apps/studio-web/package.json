    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-relay": "21.0.1",
    "react-router": "7.13.0",
    "rehype-katex": "^7.0.1",
    "relay-runtime": "21.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
