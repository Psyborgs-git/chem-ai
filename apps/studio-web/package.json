{
  "name": "studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm relay && vite",
    "build": "pnpm relay && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm relay && tsc -b --pretty",
    "test": "pnpm relay && vitest run",
    "relay": "node -e \"require('fs').mkdirSync('src/__generated__', {recursive:true})\" && relay-compiler",
    "relay:watch": "relay-compiler --watch"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-relay": "21.0.1",
    "react-router": "7.13.0",
    "relay-runtime": "21.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-relay": "21.0.1",
    "jsdom": "30.1.2",
    "relay-compiler": "21.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-relay": "2.1.0",
    "vitest": "5.0.3"
  }
}
