    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-relay": "21.0.1",
    "jsdom": "30.1.2",
    "relay-compiler": "21.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-relay": "2.1.0",
